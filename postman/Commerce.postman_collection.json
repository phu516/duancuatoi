{
  "info": {
    "name": "Pet Shop - Parts 4-10",
    "description": "Run all requests in order on a development database. Creates sample catalog, customer, orders and permanent inventory history. Uses admin_email/admin_password from the Local environment. Takes care of cookies and CSRF automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "customer_password",
      "value": "CommercePostman123!"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01 Admin login\") {",
          " const run = Date.now() + \"-\" + Math.floor(Math.random()*1000000);",
          " pm.collectionVariables.set(\"commerce_email\", \"commerce.\"+run+\"@example.test\");",
          " pm.collectionVariables.set(\"commerce_order_key\", \"order-\"+run);",
          " pm.collectionVariables.set(\"commerce_cancel_key\", \"cancel-\"+run);",
          "}",
          "if ([\"POST\", \"PUT\", \"PATCH\", \"DELETE\"].includes(pm.request.method)) {",
          "  const base = pm.variables.get(\"base_url\");",
          "  pm.sendRequest({url: base + \"/auth/csrf-token\", method: \"GET\"}, function (err, response) {",
          "    if (err || response.code !== 200) throw new Error(\"Không lấy được CSRF: kiểm tra server và base_url\");",
          "    const data = response.json();",
          "    pm.collectionVariables.set(\"csrf_token\", data.csrf_token);",
          "    pm.request.headers.upsert({key: data.header_name, value: data.csrf_token});",
          "  });",
          "}"
        ]
      }
    }
  ],
