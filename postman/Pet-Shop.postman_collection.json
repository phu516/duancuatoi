{
  "info": {
    "name": "Pet Shop - Auth Users Categories Products",
    "description": "22 API /api/v1, 44 request theo thứ tự. Cookie jar phải bật. Pre-request tự lấy CSRF. Điền admin_email và admin_password trong environment. Run toàn bộ collection để sinh customer/category/product ID. Có request lỗi chủ ý 400/401/403/404/409. Giữ lại dữ liệu có lịch sử và pet nháp.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "customer_password",
      "value": "CustomerPostman123!"
    },
    {
      "key": "customer_new_password",
      "value": "NewPostman123!"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"02 Đăng ký customer\") {",
          "  pm.collectionVariables.set(\"customer_email\", \"postman.\" + Date.now() + \".\" + Math.floor(Math.random() * 100000) + \"@example.test\");",
          "}",
          "if ([\"POST\", \"PUT\", \"PATCH\", \"DELETE\"].includes(pm.request.method)) {",
          "  const base = pm.variables.get(\"base_url\");",
          "  pm.sendRequest({url: base + \"/auth/csrf-token\", method: \"GET\"}, function (err, response) {",
          "    if (err || response.code !== 200) throw new Error(\"Không lấy được CSRF: kiểm tra server và base_url\");",
          "    const data = response.json();",
          "    pm.collectionVariables.set(\"csrf_token\", data.csrf_token);",
          "    pm.request.headers.upsert({key: data.header_name, value: data.csrf_token});",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Customer: đăng ký, đăng nhập, hồ sơ",
      "item": [
        {
          "name": "01 CSRF",
